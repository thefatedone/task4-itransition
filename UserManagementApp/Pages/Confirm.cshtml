@page
@model UserManagementApp.Pages.ConfirmModel
@{
    ViewData["Title"] = "Confirm E-mail";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="alert @(Model.Success ? "alert-success" : "alert-danger")" role="alert">
            @Model.ResultMessage
        </div>
        <a asp-page="Login" class="btn btn-primary">Go to Sign In</a>
    </div>
</div>